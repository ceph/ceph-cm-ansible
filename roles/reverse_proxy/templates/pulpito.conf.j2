# Managed by ceph-cm-ansible (roles/reverse_proxy/templates/pulpito.conf.j2).
# Hand edits on the host will be overwritten by reverse_proxy.yml.
# 2026-08-10 dgalloway: bumped inactive 60s->10m along with longer cache TTL
# below; the cache is what shields paddles from the botnet on these endpoints
# (Anubis alone is not enough -- the botnet solves the PoW challenges).
proxy_cache_path /var/cache/nginx/paddles levels=1:2 keys_zone=paddles_cache:1m max_size=50m inactive=10m;

server {
  listen 80;
  server_name pulpito.ceph.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name pulpito.ceph.com;

  ssl_certificate     /etc/letsencrypt/live/pulpito.ceph.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/pulpito.ceph.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;

  access_log /var/log/nginx/pulpito-access.log;
  error_log  /var/log/nginx/pulpito-error.log;

  # Cache the heavy read-only paddles endpoints.  Crawlers like to abuse the paddles DB by hitting these.
  # 2026-08-10 dgalloway: kept as an intentional Anubis bypass AND raised the
  # cache TTL 60s->300s.  Rationale: with proxy_cache_lock, paddles sees at
  # most ~1 request per endpoint per TTL no matter how hard the botnet hits
  # this; routing it through Anubis instead would break the pulpito filter
  # dropdowns' XHR and (worse) let challenge-solving bots reach paddles
  # uncached.  Bots can only ever get 5-min-stale dropdown JSON here.
  location ~* ^/_paddles/(branches|suites|machine_types)/ {
    proxy_pass https://pulpito-pulpito.apps.pok.os.sepia.ceph.com;
    proxy_set_header Host pulpito-pulpito.apps.pok.os.sepia.ceph.com;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_ssl_server_name on;
    proxy_ssl_name pulpito-pulpito.apps.pok.os.sepia.ceph.com;
    proxy_http_version 1.1;

    proxy_cache paddles_cache;
    proxy_cache_valid 200 300s;
    proxy_cache_use_stale error timeout updating;
    proxy_cache_lock on;
    add_header X-Cache-Status $upstream_cache_status;
  }

  # 2026-09-17 dgalloway: read-only paddles proxy for external CI dashboards
  # (first consumer: the nvmeof team's Jenkins in IBM Cloud).  paddles has no
  # auth of its own, so this is GET-only and source-IP allowlisted.  It exists
  # so read-only consumers never need a WireGuard peer into the lab.
  # Managed by ceph-cm-ansible roles/reverse_proxy; third-party addresses are
  # added via reverse_proxy_paddles_readonly_allow_extra in the secrets repo.
  location ~* ^/_paddles/runs/ {
    limit_except GET { deny all; }
{% for entry in reverse_proxy_paddles_readonly_allow + reverse_proxy_paddles_readonly_allow_extra %}
    allow {{ entry.cidr }};  # {{ entry.comment }}
{% endfor %}
    deny all;

    rewrite ^/_paddles/(.*)$ /$1 break;
    proxy_pass https://paddles.front.sepia.ceph.com;
    proxy_set_header Host paddles.front.sepia.ceph.com;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_ssl_server_name on;
    proxy_ssl_name paddles.front.sepia.ceph.com;
    proxy_http_version 1.1;

    proxy_cache paddles_cache;
    proxy_cache_valid 200 60s;
    proxy_cache_use_stale error timeout updating;
    proxy_cache_lock on;
    add_header X-Cache-Status $upstream_cache_status;
  }

  location / {
    # 2026-08-05 dgalloway: route through Anubis (anubis@pulpito on :8923) to
    # stop scraper botnet; previous direct-to-OpenShift config commented below.
    proxy_pass http://127.0.0.1:8923;
    #proxy_pass https://pulpito-pulpito.apps.pok.os.sepia.ceph.com;

    # 2026-08-06 dgalloway: rewrite backend redirects that leak the internal
    # route hostname (nginx only does this automatically when proxy_pass
    # matches the Location host, which stopped being true with the Anubis hop)
    proxy_redirect http://pulpito-pulpito.apps.pok.os.sepia.ceph.com/ /;
    proxy_redirect https://pulpito-pulpito.apps.pok.os.sepia.ceph.com/ /;

    # Make OpenShift router match the correct route
    proxy_set_header Host pulpito-pulpito.apps.pok.os.sepia.ceph.com;

    # Preserve original public host for the app (if it cares)
    proxy_set_header X-Forwarded-Host $host;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Ensure SNI is sent upstream (not needed for local Anubis hop)
    #proxy_ssl_server_name on;
    #proxy_ssl_name pulpito-pulpito.apps.pok.os.sepia.ceph.com;

    proxy_http_version 1.1;
    proxy_read_timeout 600s;
    proxy_buffering off;
  }

  location = /robots.txt {
    alias /srv/robots.txt;
  }
}
