// {{ ansible_managed }}
//
// Grafana Alloy on a lab host. Two pipelines, independently switchable:
//
//   metrics  node_exporter on localhost -> Mimir   (alloy_metrics_enabled)
//   logs     journald + auditd + allowlist -> LokiStack  (alloy_logs_enabled)
//
// Everything carries inventory_hostname, the canonical name from the sepia
// inventory: the host external label on both pipelines, and the metrics
// instance/nodename labels. ansible_fqdn is never used -- it reflects whatever
// /etc/hostname and the resolver say, which drifts (the adami hosts flipped
// .front -> .maas mid-2026 when MAAS DNS changed) and is inconsistent across
// the fleet, making {host="..."} and {instance="..."} queries unguessable.

logging {
  level  = "{{ alloy_log_level }}"
  format = "logfmt"
}

{% if alloy_metrics_enabled | bool %}
// ==================================================================== metrics
// What grafana-agent did: scrape node_exporter on localhost and remote_write
// to Mimir, with the same label shape -- job="node", instance="<name>:9100",
// nodename="<name>" -- because the "Node Exporter Full" dashboard
// (grafana.com 1860, jenkins-grafana/dashboards/node-exporter-lab.yaml in
// ceph/sepia-openshift) selects hosts by those labels and the provisioned
// node-exporter alerts there match literal instance values. <name> is
// inventory_hostname; the alert expressions in sepia-openshift were updated
// in the same change that made it so. Change one only with the other.

prometheus.scrape "node" {
  targets = [
    {
      __address__ = "{{ alloy_node_exporter_address }}",
      instance    = "{{ alloy_node_instance }}",
      nodename    = "{{ alloy_node_nodename }}",
    },
  ]

  job_name        = "{{ alloy_node_job }}"
  scrape_interval = "{{ alloy_node_scrape_interval }}"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "{{ alloy_mimir_url }}"
{% if alloy_mimir_basic_auth | bool %}

    basic_auth {
      username      = "{{ mimir_username }}"
      password_file = "{{ alloy_mimir_password_file }}"
    }
{% endif %}
{% if alloy_mimir_ca_file %}

    tls_config {
      ca_file = "{{ alloy_mimir_ca_file }}"
    }
{% elif alloy_mimir_insecure_skip_verify | bool %}

    tls_config {
      insecure_skip_verify = true
    }
{% endif %}
  }

  external_labels = {
    host = "{{ inventory_hostname }}",
  }
}
{% endif %}

{% if alloy_logs_enabled | bool %}
// ======================================================================= logs
// This collects the systemd journal, auditd, and an explicit allowlist of extra
// files. It does NOT collect all of /var/log, on purpose:
//
//   - /var/log/messages, secure, cron (RedHat) and syslog, auth.log (Debian) are
//     rsyslog copies of the journal. Collecting them alongside the journal
//     double-ingests every line.
//   - wtmp, btmp, lastlog and tallylog are binary. The login events they hold
//     are already in the journal in text form.
//   - /var/log/journal/** is the binary journal, read below via
//     loki.source.journal.
//   - Rotated and compressed files (*.1, *.gz) would re-ingest the whole history
//     on every logrotate run.
//
// Anything else that matters goes in alloy_extra_log_paths, per group.

loki.write "lokistack" {
  endpoint {
    url               = "{{ alloy_lokistack_url }}"
    bearer_token_file = "{{ alloy_token_file }}"

    tls_config {
      ca_file = "{{ alloy_ca_file }}"
    }
  }

  // Keep these few and low-cardinality. Loki indexes every label, and a
  // high-cardinality label (pid, request id, message content) is the classic way
  // to make a Loki install unqueryable.
  external_labels = {
    host   = "{{ inventory_hostname }}",
    lab    = "{{ lab_name | default('sepia') }}",
    origin = "baremetal",
  }
}

// ---------------------------------------------------------------- journal ---
// The primary source. Covers sshd, sudo, su, systemd units, the kernel, cron,
// and anything a service logs to stdout under systemd.

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "journal_host"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "syslog_identifier"
  }
}

loki.source.journal "read" {
  path = "/var/log/journal"

  // On a cold start, don't replay more than this. Otherwise standing up a new
  // host dumps its entire retained journal into Loki in one burst.
  max_age = "{{ alloy_journal_max_age }}"

  relabel_rules = loki.relabel.journal.rules
  labels        = { job = "systemd-journal" }
  forward_to    = [loki.write.lokistack.receiver]
}

{% if alloy_auditd_enabled | bool %}
// ----------------------------------------------------------------- auditd ---
// auditd writes outside the journal, so it has to be named explicitly. This is
// the record of syscall-level activity -- who ran what as whom.

local.file_match "auditd" {
  path_targets = [
    {
      __path__ = "/var/log/audit/audit.log",
      job      = "auditd",
    },
  ]
}

loki.source.file "auditd" {
  targets    = local.file_match.auditd.targets
  forward_to = [loki.write.lokistack.receiver]
}
{% endif %}

{% if alloy_extra_log_paths %}
// ------------------------------------------------------------ extra files ---
// Per-group allowlist from alloy_extra_log_paths.

local.file_match "extra" {
  path_targets = [
{% for path in alloy_extra_log_paths %}
    {
      __path__         = "{{ path }}",
      __path_exclude__ = "**/*.gz,**/*.[0-9]",
      job              = "varlog",
    },
{% endfor %}
  ]

  // Re-glob periodically so newly created files get picked up without a restart.
  sync_period = "1m"
}

loki.source.file "extra" {
  targets    = local.file_match.extra.targets
  forward_to = [loki.write.lokistack.receiver]
}
{% endif %}
{% endif %}
