{% set site = reverse_proxy_site_catalog['pulpito-ng'] %}
# {{ ansible_managed }}
server {
  listen 80;
  server_name pulpito-ng.ceph.com;
  #return 301 https://$host$request_uri;
  access_log /var/log/nginx/pulpito-ng-access.log;
  error_log  /var/log/nginx/pulpito-ng-error.log;
  location / {
    # 2026-08-05 dgalloway: route through Anubis (anubis@pulpito-ng) to stop
    # scraper botnet.
    proxy_pass http://127.0.0.1:{{ site.anubis.port }};

    # 2026-08-06 dgalloway: rewrite backend redirects that leak the internal
    # route hostname (see pulpito.conf)
    proxy_redirect http://{{ site.upstream }}/ /;
    proxy_redirect https://{{ site.upstream }}/ /;
    proxy_http_version 1.1;

    # Make OpenShift router match the correct route
    proxy_set_header Host {{ site.upstream }};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_read_timeout 600s;
    #proxy_buffering off;
  }
}

server {
  listen 443 ssl;
  server_name pulpito-ng.ceph.com;

  ssl_certificate     /etc/letsencrypt/live/pulpito-ng.ceph.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/pulpito-ng.ceph.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;

  access_log /var/log/nginx/pulpito-ng-access.log;
  error_log  /var/log/nginx/pulpito-ng-error.log;

  location / {
    # 2026-08-05 dgalloway: route through Anubis (anubis@pulpito-ng) to stop
    # scraper botnet.
    proxy_pass http://127.0.0.1:{{ site.anubis.port }};

    # 2026-08-06 dgalloway: rewrite backend redirects that leak the internal
    # route hostname (see pulpito.conf)
    proxy_redirect http://{{ site.upstream }}/ /;
    proxy_redirect https://{{ site.upstream }}/ /;
    proxy_http_version 1.1;

    # Make OpenShift router match the correct route
    proxy_set_header Host {{ site.upstream }};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # zack: ???
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_read_timeout 600s;
    #proxy_buffering off;
  }

  location = /robots.txt {
    alias /srv/robots.txt;
  }
}
