# {{ ansible_managed }}
# roles/public_facing/templates/reverse_proxy/nginx.conf.j2

user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
include /etc/nginx/modules-enabled/*.conf;

events {
	worker_connections 768;
	# multi_accept on;
}

http {
	# dgalloway added to resolve reverse proxy URLs
	resolver {{ reverse_proxy_internal_ip }} valid=30s ipv6=off;
	resolver_timeout 5s;

{% if 'qa-proxy' in reverse_proxy_sites %}
        # dgalloway added. a bot crawling from azure caused an outage by downloading
	# a bunch of files from qa-proxy all at once.
	limit_req_zone $binary_remote_addr zone=qa_proxy_req:10m rate=20r/s;
	limit_conn_zone $binary_remote_addr zone=qa_proxy_conn:10m;

{% endif %}
	##
	# Basic Settings
	##

	sendfile on;
	tcp_nopush on;
	types_hash_max_size 2048;
	# server_tokens off;

	# server_names_hash_bucket_size 64;
	# server_name_in_redirect off;

	include /etc/nginx/mime.types;
	default_type application/octet-stream;

	##
	# SSL Settings
	##

	ssl_protocols TLSv1 TLSv1.1 TLSv1.2 TLSv1.3; # Dropping SSLv3, ref: POODLE
	ssl_prefer_server_ciphers on;

	##
	# Logging Settings
	##

	access_log /var/log/nginx/access.log;

	##
	# Gzip Settings
	##

	gzip on;

	# gzip_vary on;
	# gzip_proxied any;
	# gzip_comp_level 6;
	# gzip_buffers 16 8k;
	# gzip_http_version 1.1;
	# gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

	##
	# Virtual Host Configs
	##

	include /etc/nginx/conf.d/*.conf;
	include /etc/nginx/sites-enabled/*;
}
